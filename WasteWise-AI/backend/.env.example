# Local SQL Server: DESKTOP-50UOFO0 is the verified Windows hostname.
DB_SERVER=localhost
DB_NAME=WasteWiseDB
DB_DRIVER=ODBC Driver 18 for SQL Server
# Choose the authentication method that matches your SQL Server/SSMS connection.
DB_AUTHENTICATION=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Generate a unique secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30

# Comma-separated browser origins; never use * with credentialed CORS.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
